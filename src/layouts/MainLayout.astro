---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Popups from '../components/site/Popups.astro';
import ScrollReveal from '../components/site/ScrollReveal.astro';
import { site } from '../config/site';
import { IMAGE_WIDTHS, optimizedSrcSet, optimizedUrl } from '../lib/images';
import asap400 from '@fontsource/asap/files/asap-latin-400-normal.woff2?url';
import livvic600 from '@fontsource/livvic/files/livvic-latin-600-normal.woff2?url';
import '@fontsource/asap/latin-400.css';
import '@fontsource/asap/latin-600.css';
import '@fontsource/asap/latin-700.css';
import '@fontsource/livvic/latin-400.css';
import '@fontsource/livvic/latin-600.css';
import '@fontsource/livvic/latin-700.css';
import '../styles/global.css';

const heroPreloadMobileSizes = 'calc(100vw - 48px)';
const heroPreloadDesktopSizes = 'min(900px, 55vw)';
const heroMobileQuality = 72;
const heroDesktopQuality = 80;
const heroPreloadMobileSrcSet = optimizedSrcSet(
  site.heroImageUrl,
  [...IMAGE_WIDTHS.heroMobile],
  heroMobileQuality,
);
const heroPreloadDesktopSrcSet = optimizedSrcSet(
  site.heroImageUrl,
  [...IMAGE_WIDTHS.heroDesktop],
  heroDesktopQuality,
);
/** Lighthouse mobile ≈ 412×1.75 → ~720w; preload that candidate. */
const heroPreloadMobileUrl = optimizedUrl(
  site.heroImageUrl,
  640,
  heroMobileQuality,
);
const heroPreloadDesktopUrl = optimizedUrl(
  site.heroImageUrl,
  960,
  heroDesktopQuality,
);

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogImage = site.ogImageUrl,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url).href;
const ogImageURL = new URL(ogImage, site.url).href;

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim() || '';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={site.faviconUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Children receiving food support from Anisa Foundation" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://anisafoundation.sirv.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.pathedits.com" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={livvic600}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={asap400}
      crossorigin
    />
    <link
      rel="preload"
      as="image"
      href={heroPreloadMobileUrl}
      imagesrcset={heroPreloadMobileSrcSet}
      imagesizes={heroPreloadMobileSizes}
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={heroPreloadDesktopUrl}
      imagesrcset={heroPreloadDesktopSrcSet}
      imagesizes={heroPreloadDesktopSizes}
      media="(min-width: 768px)"
      fetchpriority="high"
    />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>

    {
      gaId && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
          />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', gaId);
          </script>
        </>
      )
    }

    {
      plausibleDomain && (
        <script
          defer
          data-domain={plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Popups />
    <ScrollReveal />
  </body>
</html>
