---
import ArrowButton from './ArrowButton.astro';
import { site } from '../../config/site';

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || site.turnstileSiteKey;

/**
 * Delivery priority:
 * 1) Vercel /api/contact (optional)
 * 2) Web3Forms (recommended free path)
 * 3) Formspree
 * 4) mailto fallback
 */
const contactApiEnabled =
  import.meta.env.PUBLIC_CONTACT_API === 'true' ||
  import.meta.env.PUBLIC_CONTACT_API === '1';
const web3formsAccessKey =
  import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() || '';
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT?.trim() || '';
const formEndpoint = contactApiEnabled
  ? '/api/contact'
  : web3formsAccessKey
    ? 'https://api.web3forms.com/submit'
    : formspreeEndpoint;
---

<dialog class="popup-dialog" aria-modal="true">
  <div class="popup-stage">
    <button type="button" class="popup-close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M13 12l5-5-1-1-5 5-5-5-1 1 5 5-5 5 1 1 5-5 5 5 1-1z"></path>
      </svg>
    </button>

    <div class="popup-contact popup-panel" data-panel="help" id="contact">
      <div class="title">
        <h2 id="help-title">How you can help</h2>
        <p>
          If you want to be part of helping us change even more lives, here’s how
          you can get involved.
        </p>
      </div>

      <div class="content">
        <div class="item item-1">
          <figure>
            <img src={site.pathLogoUrl} alt="Path logo" width="188" height="88" />
          </figure>
          <div class="text">
            <h3>Work <span>with Path</span></h3>
            <p>
              The Anisa Foundation is a project from the team behind Path—professional
              photo editing that’s good for business AND good for the world. 5% of
              all proceeds go directly towards our charitable work.
            </p>
            <div class="btn-wrap">
              <ArrowButton
                href="https://pathedits.com/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Work with Path
              </ArrowButton>
            </div>
          </div>
        </div>

        <div class="item item-2">
          <figure>
            <img
              src={site.heartEnvelopeUrl}
              alt="Heart-shaped envelope icon"
              width="120"
              height="120"
            />
          </figure>
          <div class="text">
            <h3><span>Connect</span> with us</h3>
            <p>
              Have an idea for how we can work together, or another reason you want
              to get in touch? Contact us any time.
            </p>
            <div class="btn-wrap">
              <ArrowButton href="#form">Contact Anisa Foundation</ArrowButton>
            </div>
          </div>
        </div>
      </div>

      <div class="bottom">
        <p>Thanks so much for your support.</p>
      </div>
    </div>

    <div class="popup-contact popup-form popup-panel" data-panel="form" id="form">
      <div class="title-form">
        <div class="logo-wrap">
          <img
            src={site.heartEnvelopeUrl}
            alt="Heart-shaped envelope icon"
            width="120"
            height="120"
          />
        </div>
        <h2 id="form-title">Contact the Anisa Foundation</h2>
        <p>
          We’d love to hear from you. Connect with us by sending a message here, or you can email us at{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>

      <form
        class="default-form"
        data-email={site.email}
        data-endpoint={formEndpoint}
        data-web3forms-key={web3formsAccessKey}
        novalidate
      >
        <div class="input-wrap">
          <label for="contact-name">what’s your first and last name?</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            maxlength="400"
            required
            placeholder="Your full name"
            autocomplete="name"
          />
        </div>
        <div class="input-wrap">
          <label for="contact-email">what’s your email?</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            maxlength="400"
            required
            placeholder="Your email address"
            autocomplete="email"
          />
        </div>
        <div class="input-wrap input-wrap-full">
          <label for="contact-message">what do you want us to know?</label>
          <textarea
            id="contact-message"
            name="message"
            maxlength="2000"
            required
            placeholder="Write your message here"
          ></textarea>
        </div>
        <div
          class="turnstile-wrap"
          data-sitekey={turnstileSiteKey}
          aria-label="Security check"
        >
          <div class="cf-turnstile"></div>
        </div>
        <div class="input-wrap-submit">
          <button type="submit" class="btn-arrow btn-blue">
            SUBMIT
            <img src="/images/arrow-white.svg" alt="" width="20" height="16" />
          </button>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</dialog>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

<script>
  const TRANSITION_MS = 380;

  declare global {
    interface Window {
      turnstile?: {
        render: (
          element: HTMLElement | string,
          options: {
            sitekey: string;
            theme?: string;
            callback?: (token: string) => void;
            'expired-callback'?: () => void;
            'error-callback'?: () => void;
          },
        ) => string;
        reset: (widgetId?: string) => void;
        getResponse: (widgetId?: string) => string;
        ready?: (callback: () => void) => void;
      };
    }
  }

  function wait(ms: number) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  function openMailto(contactEmail: string, name: string, email: string, message: string) {
    const subject = encodeURIComponent('Message from the Anisa Foundation website');
    const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`);
    window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
  }

  function setupPopups() {
    const dialog = document.querySelector('.popup-dialog');
    if (!(dialog instanceof HTMLDialogElement) || dialog.dataset.ready === 'true') {
      return;
    }
    dialog.dataset.ready = 'true';

    const helpPanel = dialog.querySelector('[data-panel="help"]');
    const formPanel = dialog.querySelector('[data-panel="form"]');
    const form = dialog.querySelector('.default-form');
    const status = dialog.querySelector('.form-status');
    const turnstileWrap = dialog.querySelector('.turnstile-wrap');
    const turnstileMount = dialog.querySelector('.cf-turnstile');

    if (!(helpPanel instanceof HTMLElement) || !(formPanel instanceof HTMLElement)) {
      return;
    }

    let turnstileWidgetId: string | null = null;
    let turnstileToken = '';
    const sitekey =
      turnstileWrap instanceof HTMLElement
        ? turnstileWrap.dataset.sitekey?.trim() ?? ''
        : '';

    const resetTurnstile = () => {
      turnstileToken = '';
      if (turnstileWidgetId && window.turnstile) {
        window.turnstile.reset(turnstileWidgetId);
      }
    };

    const renderTurnstile = () => {
      if (!sitekey || !(turnstileMount instanceof HTMLElement) || !window.turnstile) {
        return;
      }
      turnstileWidgetId ||= window.turnstile.render(turnstileMount, {
        sitekey,
        theme: 'light',
        callback: (token) => {
          turnstileToken = token;
        },
        'expired-callback': () => {
          turnstileToken = '';
        },
        'error-callback': () => {
          turnstileToken = '';
        },
      });
    };

    const ensureTurnstile = () => {
      if (!sitekey) return;
      if (window.turnstile) {
        renderTurnstile();
        return;
      }
      window.turnstile?.ready?.(renderTurnstile);
      const started = Date.now();
      const timer = window.setInterval(() => {
        if (window.turnstile) {
          window.clearInterval(timer);
          renderTurnstile();
          return;
        }
        if (Date.now() - started > 10000) window.clearInterval(timer);
      }, 100);
    };

    const resetScroll = () => {
      dialog.scrollTop = 0;
      dialog.scrollLeft = 0;
      helpPanel.scrollTop = 0;
      formPanel.scrollTop = 0;
      const stage = dialog.querySelector('.popup-stage');
      if (stage instanceof HTMLElement) {
        stage.scrollTop = 0;
        stage.scrollLeft = 0;
      }
    };

    const setPanel = (name: 'help' | 'form') => {
      helpPanel.classList.toggle('is-active', name === 'help');
      formPanel.classList.toggle('is-active', name === 'form');
      dialog.setAttribute(
        'aria-labelledby',
        name === 'help' ? 'help-title' : 'form-title',
      );
      resetScroll();
      requestAnimationFrame(resetScroll);
      if (name === 'form') {
        ensureTurnstile();
        window.setTimeout(resetScroll, 50);
        window.setTimeout(resetScroll, 200);
      }
    };

    const open = async (name: 'help' | 'form') => {
      setPanel(name);
      if (!dialog.open) {
        dialog.classList.remove('is-closing');
        dialog.showModal();
        resetScroll();
        dialog.classList.add('is-opening');
        await wait(TRANSITION_MS);
        dialog.classList.remove('is-opening');
        resetScroll();
      }
    };

    const close = async () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      dialog.classList.add('is-closing');
      await wait(TRANSITION_MS);
      dialog.close();
      dialog.classList.remove('is-closing');
      setPanel('help');
      resetScroll();
    };

    const goToForm = async () => {
      if (!dialog.open) {
        await open('form');
        return;
      }
      if (formPanel.classList.contains('is-active')) return;
      helpPanel.classList.add('is-leaving');
      await wait(TRANSITION_MS);
      setPanel('form');
      helpPanel.classList.remove('is-leaving');
      resetScroll();
    };

    document.querySelectorAll('a[href="#contact"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        void open('help');
      });
    });

    document.querySelectorAll('a[href="#form"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        void goToForm();
      });
    });

    dialog.querySelector('.popup-close')?.addEventListener('click', () => {
      void close();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) void close();
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      void close();
    });

    if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = '';
        status.classList.remove('is-error', 'is-success');

        const name = String(new FormData(form).get('name') ?? '').trim();
        const email = String(new FormData(form).get('email') ?? '').trim();
        const message = String(new FormData(form).get('message') ?? '').trim();
        const token =
          turnstileToken ||
          (turnstileWidgetId && window.turnstile
            ? window.turnstile.getResponse(turnstileWidgetId)
            : '') ||
          String(new FormData(form).get('cf-turnstile-response') ?? '').trim();

        if (!name || !email || !message) {
          status.textContent = 'Please fill in all of the required fields.';
          status.classList.add('is-error');
          return;
        }

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          status.textContent = 'Please enter a valid email address.';
          status.classList.add('is-error');
          return;
        }

        if (!sitekey) {
          status.textContent =
            'The security check is not configured. Please email us directly.';
          status.classList.add('is-error');
          return;
        }

        if (!token) {
          status.textContent = 'Please complete the security check before submitting.';
          status.classList.add('is-error');
          return;
        }

        const contactEmail = form.dataset.email?.trim() || 'hello@anisafoundation.org';
        const endpoint = form.dataset.endpoint?.trim() || '';
        const web3formsKey = form.dataset.web3formsKey?.trim() || '';
        const submitButton = form.querySelector('button[type="submit"]');
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

        const finishMailto = (note: string) => {
          openMailto(contactEmail, name, email, message);
          status.textContent = note;
          status.classList.add('is-success');
          form.reset();
          resetTurnstile();
        };

        try {
          if (!endpoint) {
            finishMailto(
              'Thanks — your email app should open so you can send the message. If it doesn’t, email us at hello@anisafoundation.org.',
            );
            return;
          }

          const isWeb3Forms = endpoint.includes('web3forms.com');
          const isFormspree = endpoint.includes('formspree.io');

          let payload: Record<string, string>;
          if (isWeb3Forms) {
            if (!web3formsKey) {
              status.textContent =
                'The contact form is not configured. Please email us directly.';
              status.classList.add('is-error');
              return;
            }
            payload = {
              access_key: web3formsKey,
              name,
              email,
              message,
              subject: 'Message from the Anisa Foundation website',
              from_name: name,
            };
          } else if (isFormspree) {
            payload = {
              name,
              email,
              message,
              'cf-turnstile-response': token,
              _subject: 'Message from the Anisa Foundation website',
            };
          } else {
            payload = {
              name,
              email,
              message,
              turnstileToken: token,
            };
          }

          const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const data = (await response.json().catch(() => ({}))) as {
            ok?: boolean;
            success?: boolean;
            delivered?: boolean;
            message?: string;
            error?: string;
          };

          const failed =
            !response.ok || data.ok === false || data.success === false;
          if (failed) {
            status.textContent =
              data.error ||
              data.message ||
              'Something went wrong. Please try again or email us directly.';
            status.classList.add('is-error');
            return;
          }

          if (endpoint === '/api/contact' && data.delivered === false) {
            finishMailto(
              data.message ||
                'Security check passed. Opening your email app to finish sending.',
            );
            return;
          }

          status.textContent =
            data.message || 'Thank you for your message. It has been sent.';
          status.classList.add('is-success');
          form.reset();
          resetTurnstile();
        } catch {
          status.textContent =
            'Something went wrong. Please try again or email us at hello@anisafoundation.org.';
          status.classList.add('is-error');
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    }

    if (window.location.hash === '#form') void open('form');
    if (window.location.hash === '#contact') void open('help');
  }

  setupPopups();
</script>
