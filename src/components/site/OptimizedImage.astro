---
import { IMAGE_WIDTHS, sirvSrcSet, sirvUrl, isSirvUrl, isRasterUrl } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Candidate widths for srcset (CSS pixels × DPR). */
  widths?: number[];
  /** CSS sizes hint so the browser picks the right candidate. */
  sizes?: string;
  /** Intrinsic/default delivery width when no match; defaults to prop width. */
  defaultWidth?: number;
  quality?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  widths = [...IMAGE_WIDTHS.half],
  sizes = '100vw',
  defaultWidth = width,
  quality = 82,
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  class: className,
} = Astro.props;

const optimize = isSirvUrl(src) && isRasterUrl(src);
const resolvedSrc = optimize ? sirvUrl(src, defaultWidth, quality) : src;
const srcset = optimize ? sirvSrcSet(src, widths, quality) : undefined;
---

<img
  src={resolvedSrc}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding={decoding}
  class={className}
/>
