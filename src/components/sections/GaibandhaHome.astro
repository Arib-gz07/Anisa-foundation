---
import { site } from '../../config/site';
import OptimizedImage from '../site/OptimizedImage.astro';
import { IMAGE_WIDTHS } from '../../lib/images';
---

<section class="map-section">
  <div class="bg">
    <img
      src={site.gaibandhaMapUrl}
      alt="Map showing Gaibandha location in Bangladesh"
      width="1436"
      height="1043"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="content-width">
    <div class="title">
      <h2>Gaibandha</h2>
      <h3>Is our home</h3>
    </div>
    <div class="content">
      <div class="left">
        <figure data-aos="fade-up" data-aos-duration="1000">
          <OptimizedImage
            src={site.gaibandhaChildrenUrl}
            alt="Children receiving Eid food packages from Anisa Foundation"
            width={1256}
            height={679}
            widths={[...IMAGE_WIDTHS.half]}
            sizes="(max-width: 991px) 100vw, min(620px, 48vw)"
            defaultWidth={800}
            loading="lazy"
          />
        </figure>
      </div>
      <div class="right">
        <div class="text">
          <div class="logo-wrap">
            <img
              src={site.iconLogoUrl}
              alt=""
              width="80"
              height="62"
              loading="lazy"
              decoding="async"
            />
          </div>
          <h6>
            We’re dedicated to ending suffering for everyone in the district—
            working together to create a community founded on compassion and
            hope.
          </h6>
          <p>
            Because our roots are in the community we serve, we’re able to help,
            exactly when and where it’s needed most.
          </p>
        </div>
        <figure data-aos="fade-up" data-aos-duration="1000">
          <OptimizedImage
            src={site.gaibandhaGirlsUrl}
            alt="Two girls supported by Anisa Foundation"
            width={386}
            height={370}
            widths={[...IMAGE_WIDTHS.card]}
            sizes="(max-width: 991px) 90vw, min(400px, 32vw)"
            defaultWidth={480}
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </div>
</section>
