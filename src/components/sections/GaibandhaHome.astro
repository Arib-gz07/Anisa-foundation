---
import { site } from '../../config/site';
---

<section class="map-section">
  <div class="bg">
    <img
      src={site.gaibandhaMapUrl}
      alt="Map showing Gaibandha location in Bangladesh"
      width="1436"
      height="1043"
    />
  </div>
  <div class="content-width">
    <div class="title">
      <h2>Gaibandha</h2>
      <h3>Is our home</h3>
    </div>
    <div class="content">
      <div class="left">
        <figure data-aos="fade-up" data-aos-duration="1000">
          <img
            src={site.gaibandhaChildrenUrl}
            alt="Children receiving Eid food packages from Anisa Foundation"
            width="1256"
            height="679"
          />
        </figure>
      </div>
      <div class="right">
        <div class="text">
          <div class="logo-wrap">
            <img
              src={site.iconLogoUrl}
              alt=""
              width="80"
              height="62"
            />
          </div>
          <h6>
            We’re dedicated to ending suffering for everyone in the district—
            working together to create a community founded on compassion and
            hope.
          </h6>
          <p>
            Because our roots are in the community we serve, we’re able to help,
            exactly when and where it’s needed most.
          </p>
        </div>
        <figure data-aos="fade-up" data-aos-duration="1000">
          <img
            src={site.gaibandhaGirlsUrl}
            alt="Two girls supported by Anisa Foundation"
            width="386"
            height="370"
          />
        </figure>
      </div>
    </div>
  </div>
</section>
