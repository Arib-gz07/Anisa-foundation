---
import { initiatives } from '../../config/site';
import OptimizedImage from '../site/OptimizedImage.astro';
import { IMAGE_WIDTHS } from '../../lib/images';
---

<section class="text-img-line">
  <div class="content-width">
    <h2>Some of our <span>initiatives</span></h2>
    <div class="content">
      {
        initiatives.map((item, index) => (
          <div class={`item item-${index + 1}`}>
            <div class="text">
              <h3>
                {item.title} <span>{item.titleAccent}</span>
              </h3>
              <p>{item.body}</p>
            </div>
            <figure data-aos="fade-up" data-aos-duration="1000">
              <OptimizedImage
                src={item.imageUrl}
                alt={item.imageAlt}
                width={774}
                height={418}
                widths={[...IMAGE_WIDTHS.half]}
                sizes="(max-width: 991px) 100vw, min(620px, 48vw)"
                defaultWidth={800}
                loading="lazy"
              />
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>
