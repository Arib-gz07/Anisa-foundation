---
import { site } from '../../config/site';
import ArrowButton from '../site/ArrowButton.astro';
import { IMAGE_WIDTHS, optimizedSrcSet, optimizedUrl } from '../../lib/images';

const heroMobileQuality = 72;
const heroDesktopQuality = 80;
const heroSizesMobile = 'calc(100vw - 48px)';
const heroSizesDesktop = 'min(900px, 55vw)';
const heroMobileSrcSet = optimizedSrcSet(
  site.heroImageUrl,
  [...IMAGE_WIDTHS.heroMobile],
  heroMobileQuality,
);
const heroDesktopSrcSet = optimizedSrcSet(
  site.heroImageUrl,
  [...IMAGE_WIDTHS.heroDesktop],
  heroDesktopQuality,
);
const heroMobileSrc = optimizedUrl(site.heroImageUrl, 640, heroMobileQuality);
---

<section class="home-banner">
  <div class="content-width">
    <div class="content">
      <h1><span>Hope (and help)</span><br />where they’re needed most</h1>
      <div class="text-wrap">
        <p>
          The Anisa Foundation is a registered charity based in Gaibandha,
          Bangladesh. We help our community access life-changing—and sometimes
          life-saving—care and support.
        </p>
      </div>
      <div class="hero-image">
        <picture>
          <source
            media="(max-width: 767px)"
            srcset={heroMobileSrcSet}
            sizes={heroSizesMobile}
          />
          <source
            media="(min-width: 768px)"
            srcset={heroDesktopSrcSet}
            sizes={heroSizesDesktop}
          />
          <img
            src={heroMobileSrc}
            alt="Children receiving food support from Anisa Foundation"
            width={1052}
            height={842}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="btn-wrap">
        <ArrowButton href="#contact">See how you can help</ArrowButton>
      </div>
    </div>
  </div>
</section>
