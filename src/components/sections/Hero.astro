---
import { site } from '../../config/site';
import ArrowButton from '../site/ArrowButton.astro';
import OptimizedImage from '../site/OptimizedImage.astro';
import { IMAGE_WIDTHS } from '../../lib/images';

const heroSizes = '(max-width: 767px) 100vw, min(900px, 55vw)';
const heroWidths = [...IMAGE_WIDTHS.hero];
---

<section class="home-banner">
  <div class="content-width">
    <div class="content">
      <h1><span>Hope (and help)</span><br />where they’re needed most</h1>
      <div class="text-wrap">
        <p>
          The Anisa Foundation is a registered charity based in Gaibandha,
          Bangladesh. We help our community access life-changing—and sometimes
          life-saving—care and support.
        </p>
      </div>
      <figure class="hero-media">
        <OptimizedImage
          src={site.heroImageUrl}
          alt="Children receiving food support from Anisa Foundation"
          width={1052}
          height={842}
          widths={heroWidths}
          sizes={heroSizes}
          defaultWidth={720}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <div class="btn-wrap">
        <ArrowButton href="#contact">See how you can help</ArrowButton>
      </div>
    </div>
  </div>
</section>
